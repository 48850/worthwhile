{
  "manifest_version": 3,
  "name": "Worthwhile",
  "version": "0.4.0",
  "description": "Filters your YouTube home feed down to the videos worth your time.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://worthwhile.worthwhile-worker.workers.dev/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["settings.js", "selectors.js", "common.js", "notinterested.js", "behaviour.js", "content.js", "watch.js", "shorts.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shorts-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Worthwhile",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
