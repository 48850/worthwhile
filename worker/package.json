{
  "name": "worthwhile-worker",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: scores YouTube items with Claude, caches scores in D1.",
  "scripts": {
    "dev": "node dev.js",
    "db:local": "wrangler d1 execute worthwhile --local --file=schema.sql",
    "db:remote": "wrangler d1 execute worthwhile --remote --file=schema.sql",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "wrangler": "^4.136.3"
  }
}
