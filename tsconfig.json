{
  // Type-checking only (`npm run typecheck`); esbuild does the building.
  // No global "chrome" types: only files under adapters/chrome opt in with
  // /// <reference types="chrome" />, so core/ and sites/ can't use chrome.*
  // without a compile error (scripts/check-boundaries.mjs checks it too).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["core", "sites", "adapters", "contracts", "shared", "tests", "scripts/**/*.ts"]
}
